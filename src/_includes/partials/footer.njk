{%- set footerCategories = products | map("category") | unique %}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand--light" href="/">
        <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.name }} logo" width="126" height="64">
        <span class="brand-name">{{ site.name }}</span>
      </a>
      <p>{{ site.description }}</p>
      <p class="footer-address"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{{ site.contact.address }}</p>
      {% set socialClass = "social-icons--footer" %}{% include "partials/social.njk" %}
    </div>
    <div>
      <h3>Quick Links</h3>
      <ul class="footer-links">
        {%- for item in navigation %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h3>Product Categories</h3>
      <ul class="footer-links">
        {%- for cat in footerCategories %}
        <li><a href="/products/#{{ cat | slug }}">{{ cat }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h3>Contact Us</h3>
      <ul class="footer-contact">
        <li><span>Phone</span><a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a></li>
        <li><span>Email</span><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
        <li><span>Hours</span>{{ site.contact.hours }}</li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {{ "" | year }} {{ site.legalName }}{% if not (site.legalName | string).endsWith(".") %}.{% endif %} All Rights Reserved.</p>
      <p><a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Use</a></p>
    </div>
  </div>
</footer>
<a class="back-to-top" href="#main" aria-label="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 15 6-6 6 6"/></svg></a>
