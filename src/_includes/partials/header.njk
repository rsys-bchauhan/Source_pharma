<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.name }} logo" width="44" height="44">
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-tagline">{{ site.tagline }}</span>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {%- for item in navigation %}
        {%- set isActive = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
