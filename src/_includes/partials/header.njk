<div class="topbar">
  <div class="container topbar-inner">
    <ul class="topbar-contact">
      <li><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span>{{ site.contact.address }}</span></li>
      <li><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>Contact:&nbsp;<a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a></li>
      <li><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/></svg><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
    </ul>
    {% include "partials/social.njk" %}
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.name }} logo" width="126" height="64">
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-tagline">{{ site.tagline }}</span>
      </span>
    </a>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {%- for item in navigation %}
        {%- set isActive = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn--primary btn--square" href="/products/">Product List</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
