<section class="page-banner">
  <div class="container">
    <h1>{{ heading or title }}</h1>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">{{ site.name }}</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">{{ title }}</span>
    </nav>
    {%- if lead %}<p class="banner-lead">{{ lead }}</p>{% endif %}
  </div>
</section>
